generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  docente
  operador_horarios
  administrador_sistema
  director_departamento
  decano
  secretaria
}



model Usuario {
  id_usuario              Int                   @id @default(autoincrement())
  codigo                  String                @unique
  nombres                 String
  apellidos               String
  correo_electronico      String?               @unique
  contrasena_hash         String
  rol                     RolUsuario            @default(docente)
  activo                  Boolean               @default(true)
  ultimo_acceso           DateTime?
  fecha_creacion          DateTime              @default(now())
  fecha_actualizacion     DateTime              @default(now())
  dni                     String?               @unique
  docente                 Docente?
  declaracionesValidadas  DeclaracionHoraria[] @relation("ValidadoPor")
  cladsValidados          CargaLectivaAdicional[] @relation("CladValidadoPor")
}

enum CondicionDocente {
  ORDINARIO
  EXTRAORDINARIO
  CONTRATADO
}

enum CategoriaDocente {
  PRINCIPAL
  ASOCIADO
  AUXILIAR
}

enum RegimenDedicacion {
  DE
  TC
  TP1
  TP2
  TP3
}

enum TipoExtraordinario {
  HONORIS_CAUSA
  EMERITO
  HONORARIO
  INVESTIGADOR
  VISITANTE
}

enum TipoContrato {
  A1
  A2
  A3
  B1
  B2
  B3
}

model Docente {
  id_docente                Int                               @id @default(autoincrement())
  id_usuario                Int?                              @unique
  codigo_docente            String                            @unique
  nombres                   String
  apellidos                 String
  // New fields
  condicion                 CondicionDocente?
  categoriaDocente          CategoriaDocente?
  regimenDedicacion         RegimenDedicacion?
  tipoExtraordinario        TipoExtraordinario?
  tipoContrato              TipoContrato?
  esInvestigadorAcreditado  Boolean                           @default(false)
  nivelRenacyt              String?
  sancionActiva             Boolean                           @default(false)
  sancionHasta              DateTime?
  // Existing fields
  fecha_ingreso             DateTime?
  correo_electronico        String?
  telefono                  String?
  grado_academico           String?
  especialidad              String?
  horas_maximas_semanales   Int                               @default(40)
  activo                    Boolean                           @default(true)
  dni                       String?
  departamentoId            String?
  departamento              DepartamentoAcademico?            @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  facultadId                String?
  facultad                  Facultad?                         @relation(fields: [facultadId], references: [id], onDelete: SetNull)
  cola_notificaciones       ColaNotificaciones[]
  disponibilidad            DisponibilidadDocente[]
  usuario                   Usuario?                          @relation(fields: [id_usuario], references: [id_usuario])
  docente_cursos            DocenteCurso[]
  historial_notificaciones  HistorialNotificaciones[]
  horarios_asignados        HorarioAsignado[]
  preferencias_notificacion PreferenciasNotificacionDocente[]
  selecciones_temporales    SeleccionTemporalHorario[]
  declaraciones_horarias    DeclaracionHoraria[]
  cargasLectivasAdicionales CargaLectivaAdicional[]
  integracionesSimuladas    IntegracionSimulada[]
}

model PersonalApoyo {
  id             String                  @id @default(cuid())
  nombre         String
  tipo           String                  // "JEFE_PRACTICA" por ahora
  modalidad      String                  // "TC" | "TP1" | "TP2" | "TP3"
  departamentoId String?
  departamento   DepartamentoAcademico?  @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model MallaCurricular {
  id_malla         Int                 @id @default(autoincrement())
  nombre           String
  descripcion      String?
  anio             Int
  activo           Boolean             @default(true)
  facultadId       String?
  facultad         Facultad?            @relation(fields: [facultadId], references: [id], onDelete: SetNull)
  escuelaId        String?
  escuela          EscuelaProfesional? @relation(fields: [escuelaId], references: [id], onDelete: SetNull)
  departamentoId   String
  departamento     DepartamentoAcademico @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  cursos           Curso[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Curso {
  id_curso                 Int                        @id @default(autoincrement())
  codigo                   String                     @unique
  nombre                   String
  maximo_docentes          Int                        @default(1)
  creditos                 Int
  plan_estudios            String?
  prerequisitos            String?
  activo                   Boolean                    @default(true)
  id_ciclo                 Int?
  id_malla                 Int?
  escuelaId                String?
  escuela                  EscuelaProfesional?        @relation(fields: [escuelaId], references: [id], onDelete: SetNull)
  departamentoId           String?
  departamento             DepartamentoAcademico?        @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  tipo_curso               String                     @default("linea_carrera")
  horas_teoria             Int                        @default(0)
  horas_practica           Int                        @default(0)
  horas_laboratorio        Int                        @default(0)
  departamento_responsable String?
  ciclo_rel                Ciclo?                     @relation(fields: [id_ciclo], references: [id_ciclo])
  malla_rel                MallaCurricular?           @relation(fields: [id_malla], references: [id_malla])
  curso_ambientes          CursoAmbiente[]
  docente_cursos           DocenteCurso[]
  grupos                   Grupo[]
  horarios_asignados       HorarioAsignado[]
  selecciones_temporales   SeleccionTemporalHorario[]
  cargas_lectivas          CargaLectiva[]
  prerequisitos_rel        Prerequisito[]             @relation("CursoPrerequisitos")
  es_prerequisito_de       Prerequisito[]             @relation("PrerequisitoDe")
}

model Prerequisito {
  id_prerequisito       Int   @id @default(autoincrement())
  id_curso              Int
  id_prerequisito_curso Int
  curso                 Curso @relation("CursoPrerequisitos", fields: [id_curso], references: [id_curso])
  prerequisito          Curso @relation("PrerequisitoDe", fields: [id_prerequisito_curso], references: [id_curso])

  @@unique([id_curso, id_prerequisito_curso])
}

model Ciclo {
  id_ciclo Int     @id @default(autoincrement())
  numero   Int     @unique
  nombre   String
  activo   Boolean @default(true)
  cursos   Curso[]
  grupos   Grupo[]
}

model DocenteCurso {
  id_docente_curso  Int     @id @default(autoincrement())
  id_docente        Int
  id_curso          Int
  tipo_clase        String
  experiencia_anios Int     @default(0)
  prioridad         Int     @default(1)
  activo            Boolean @default(true)
  curso             Curso   @relation(fields: [id_curso], references: [id_curso])
  docente           Docente @relation(fields: [id_docente], references: [id_docente])

  @@unique([id_docente, id_curso, tipo_clase])
}

model Grupo {
  id_grupo               Int                        @id @default(autoincrement())
  id_curso               Int
  id_periodo             Int
  codigo_grupo           String
  capacidad_maxima       Int                        @default(40)
  cantidad_matriculados  Int                        @default(0)
  activo                 Boolean                    @default(true)
  id_ciclo               Int?
  ciclo                  Ciclo?                     @relation(fields: [id_ciclo], references: [id_ciclo])
  curso                  Curso                      @relation(fields: [id_curso], references: [id_curso])
  periodo                PeriodoAcademico           @relation(fields: [id_periodo], references: [id_periodo])
  horarios_asignados     HorarioAsignado[]
  selecciones_temporales SeleccionTemporalHorario[]
  cargas_lectivas        CargaLectiva[]

  @@unique([id_curso, codigo_grupo, id_periodo])
}

model Ambiente {
  id_ambiente            Int                        @id @default(autoincrement())
  codigo                 String                     @unique
  nombre                 String
  tipo                   String
  capacidad              Int
  piso                   String?
  pabellon               String?
  equipamiento           String?
  caracteristicas        Json?
  activo                 Boolean                    @default(true)
  requiere_mantenimiento Boolean                    @default(false)
  observaciones          String?
  facultadId             String?
  facultad               Facultad?                  @relation(fields: [facultadId], references: [id], onDelete: SetNull)
  departamentoId         String?
  departamento           DepartamentoAcademico?     @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  curso_ambientes        CursoAmbiente[]
  horarios_asignados     HorarioAsignado[]
  selecciones_temporales SeleccionTemporalHorario[]
}

model CursoAmbiente {
  id_curso_ambiente Int      @id @default(autoincrement())
  id_curso          Int
  id_ambiente       Int
  tipo_clase        String
  ambiente          Ambiente @relation(fields: [id_ambiente], references: [id_ambiente])
  curso             Curso    @relation(fields: [id_curso], references: [id_curso])

  @@unique([id_curso, id_ambiente, tipo_clase])
}

model PeriodoAcademico {
  id_periodo              Int                        @id @default(autoincrement())
  codigo                  String                     @unique
  nombre                  String
  anio                    Int
  semestre                Int
  fecha_inicio            DateTime
  fecha_fin               DateTime
  fecha_inicio_clases     DateTime?
  fecha_fin_clases        DateTime?
  activo                  Boolean                    @default(true)
  estado                  String                     @default("planificacion")
  conflictos              ConflictoHorario[]
  disponibilidad_docentes DisponibilidadDocente[]
  grupos                  Grupo[]
  horarios_asignados      HorarioAsignado[]
  selecciones_temporales  SeleccionTemporalHorario[]
  ventanas_atencion       VentanaAtencion[]
  declaraciones_horarias  DeclaracionHoraria[]
}

model VentanaAtencion {
  id_ventana         Int               @id @default(autoincrement())
  id_periodo         Int
  fecha              DateTime
  orden_prioridad    Int
  modalidad          String
  categoria          String
  hora_inicio        String
  hora_fin           String
  intervalo_minutos  Int               @default(15)
  cantidad_docentes  Int               @default(0)
  cantidad_atendidos Int               @default(0)
  completado         Boolean           @default(false)
  pausado            Boolean           @default(false)
  activo             Boolean           @default(true)
  horarios_asignados HorarioAsignado[]
  periodo            PeriodoAcademico  @relation(fields: [id_periodo], references: [id_periodo])
}

model HorarioAsignado {
  id_asignacion Int              @id @default(autoincrement())
  id_docente    Int
  id_curso      Int
  id_grupo      Int
  tipo_clase    String
  id_ambiente   Int
  dia_semana    Int
  hora_inicio   String
  hora_fin      String
  id_periodo    Int
  id_ventana    Int?
  estado        String           @default("borrador")
  observaciones String?
  creado_por    Int?
  ambiente      Ambiente         @relation(fields: [id_ambiente], references: [id_ambiente])
  curso         Curso            @relation(fields: [id_curso], references: [id_curso])
  docente       Docente          @relation(fields: [id_docente], references: [id_docente])
  grupo         Grupo            @relation(fields: [id_grupo], references: [id_grupo])
  periodo       PeriodoAcademico @relation(fields: [id_periodo], references: [id_periodo])
  ventana       VentanaAtencion? @relation(fields: [id_ventana], references: [id_ventana])
}

model SeleccionTemporalHorario {
  id_seleccion     Int              @id @default(autoincrement())
  id_docente       Int
  id_curso         Int
  id_grupo         Int
  tipo_clase       String
  id_ambiente      Int
  dia_semana       Int
  hora_inicio      String
  hora_fin         String
  id_periodo       Int
  sesion_id        String
  fecha_seleccion  DateTime         @default(now())
  fecha_expiracion DateTime
  ambiente         Ambiente         @relation(fields: [id_ambiente], references: [id_ambiente])
  curso            Curso            @relation(fields: [id_curso], references: [id_curso])
  docente          Docente          @relation(fields: [id_docente], references: [id_docente])
  grupo            Grupo            @relation(fields: [id_grupo], references: [id_grupo])
  periodo          PeriodoAcademico @relation(fields: [id_periodo], references: [id_periodo])

  @@unique([sesion_id, dia_semana, hora_inicio])
}

model DisponibilidadDocente {
  id_disponibilidad  Int              @id @default(autoincrement())
  id_docente         Int
  id_periodo         Int
  dia_semana         Int
  hora_inicio        String
  hora_fin           String
  disponible         Boolean          @default(true)
  es_restriccion     Boolean          @default(false)
  motivo_restriccion String?
  docente            Docente          @relation(fields: [id_docente], references: [id_docente])
  periodo            PeriodoAcademico @relation(fields: [id_periodo], references: [id_periodo])

  @@unique([id_docente, dia_semana, hora_inicio, id_periodo])
}

model ConflictoHorario {
  id_conflicto     Int              @id @default(autoincrement())
  id_periodo       Int
  tipo_conflicto   String
  descripcion      String
  id_docente_1     Int?
  id_docente_2     Int?
  id_curso         Int?
  id_ambiente      Int?
  dia_semana       Int?
  hora_inicio      String?
  hora_fin         String?
  resuelto         Boolean          @default(false)
  fecha_deteccion  DateTime         @default(now())
  fecha_resolucion DateTime?
  resuelto_por     Int?
  periodo          PeriodoAcademico @relation(fields: [id_periodo], references: [id_periodo])
}

model PreferenciasNotificacionDocente {
  id_preferencia     Int       @id @default(autoincrement())
  id_docente         Int
  canal              String
  activo             Boolean   @default(true)
  datos_contacto     Json
  verificado         Boolean   @default(false)
  fecha_verificacion DateTime?
  docente            Docente   @relation(fields: [id_docente], references: [id_docente])

  @@unique([id_docente, canal])
}

model HistorialNotificaciones {
  id_notificacion    Int       @id @default(autoincrement())
  id_docente         Int
  id_ventana         Int?
  tipo_notificacion  String
  canal              String
  mensaje            String
  estado_envio       String    @default("pendiente")
  fecha_envio        DateTime?
  fecha_entrega      DateTime?
  codigo_respuesta   String?
  respuesta_servidor String?
  intentos           Int       @default(1)
  docente            Docente   @relation(fields: [id_docente], references: [id_docente])
}

model ColaNotificaciones {
  id_cola             Int       @id @default(autoincrement())
  id_docente          Int
  tipo_notificacion   String
  canal               String
  datos_mensaje       Json
  fecha_programada    DateTime
  prioridad           Int       @default(5)
  estado              String    @default("pendiente")
  intentos            Int       @default(0)
  maximo_intentos     Int       @default(3)
  fecha_creacion      DateTime  @default(now())
  fecha_procesamiento DateTime?
  docente             Docente   @relation(fields: [id_docente], references: [id_docente])
}

model ConfiguracionNotificaciones {
  id_configuracion        Int     @id @default(autoincrement())
  tipo_notificacion       String
  canal                   String
  activo                  Boolean @default(true)
  plantilla_mensaje       String
  hora_envio              String?
  dias_antelacion         Int?
  minutos_antelacion      Int?
  configuracion_adicional Json?
}

model DiaNoLaborable {
  id_dia_no_laborable Int      @id @default(autoincrement())
  fecha               DateTime
  descripcion         String
  tipo                String
  afecta_clases       Boolean  @default(true)
  id_periodo          Int?
}

model RestriccionInstitucional {
  id_restriccion   Int     @id @default(autoincrement())
  tipo_restriccion String
  nombre           String
  configuracion    Json
  id_periodo       Int?
  activo           Boolean @default(true)
}

model AuditoriaHorario {
  id_auditoria     Int      @id @default(autoincrement())
  id_asignacion    Int?
  accion           String
  usuario_id       Int
  datos_anteriores Json?
  datos_nuevos     Json?
  direccion_ip     String?
  motivo           String?
  fecha_registro   DateTime @default(now())
}

// ==============================
// MODELOS PARA FACULTADES, DEPARTAMENTOS Y ESCUELAS
// ==============================

enum TipoFacultad {
  FACULTAD
  FILIAL
  ADMINISTRATIVA
}

model Facultad {
  id                   String                  @id @default(cuid())
  nombre               String
  codigo               String                  @unique
  tipo                 TipoFacultad
  departamentos        DepartamentoAcademico[]
  escuelas             EscuelaProfesional[]
  ambientes            Ambiente[]
  docentes             Docente[]
  cargasLectivasSede   CargaLectiva[]          @relation("CargaLectivaSede")
  cargasNoLectivasSede CargaNoLectiva[]        @relation("CargaNoLectivaSede")
  mallas               MallaCurricular[]
  cargasLectivasAdicionalesSede CargaLectivaAdicional[] @relation("CargaLectivaAdicionalSede")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
}

model DepartamentoAcademico {
  id               String              @id @default(cuid())
  nombre           String
  facultadId       String
  facultad         Facultad            @relation(fields: [facultadId], references: [id], onDelete: Cascade)
  docentes         Docente[]
  mallas           MallaCurricular[]
  cursos           Curso[]
  ambientes        Ambiente[]
  personalApoyo    PersonalApoyo[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([nombre, facultadId])
}

model EscuelaProfesional {
  id         String            @id @default(cuid())
  nombre     String
  facultadId String
  facultad   Facultad          @relation(fields: [facultadId], references: [id], onDelete: Cascade)
  mallas     MallaCurricular[]
  cursos     Curso[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([nombre, facultadId])
}

// ==============================
// MODELOS PARA DECLARACIÓN DE CARGA HORARIA
// ==============================

enum EstadoDeclaracion {
  BORRADOR
  ENVIADO
  VALIDADO_DEPARTAMENTO
  APROBADO
  RECHAZADO
  LECTIVA_CONFIRMADA 
}

enum TipoCargaNoLectiva {
  PREPARACION_EVALUACION
  TUTORIA
  INVESTIGACION
  CAPACITACION
  GOBIERNO
  ADMINISTRACION
  ASESORIA
  RESPONSABILIDAD_SOCIAL
  COMITES_TECNICOS
  AUTOEVALUACION_ACREDITACION
  OTRO
}

enum DependenciaClad {
  FILIAL
  POSGRADO
  SEGUNDA_ESPECIALIDAD
  CENTRO_PRODUCCION
  EXTENSION_UNIVERSITARIA
}

enum EstadoClad {
  BORRADOR
  ENVIADO
  VALIDADO_DEPARTAMENTO
  APROBADO
  RECHAZADO
}

enum DiaSemana {
  LU
  MA
  MI
  JU
  VI
  SA
}

model DeclaracionHoraria {
  id_declaracion              Int                  @id @default(autoincrement())
  id_docente                  Int
  id_periodo                  Int
  ibm                         String
  condicion                   String
  categoria                   String
  dedicacion                  String
  horas_dedicacion            Int
  estado                      EstadoDeclaracion    @default(BORRADOR)
  fecha_creacion              DateTime             @default(now())
  fecha_actualizacion         DateTime             @default(now())
  fecha_envio                 DateTime?
  fecha_aprobacion            DateTime?
  observaciones               String?
  docente                     Docente              @relation(fields: [id_docente], references: [id_docente])
  periodo                     PeriodoAcademico     @relation(fields: [id_periodo], references: [id_periodo])
  cargas_lectivas             CargaLectiva[]
  cargas_no_lectivas          CargaNoLectiva[]
  formatos                    FormatoDeclaracion[]
  // Nuevos campos para flujo de aprobación
  validadoPorId               Int?
  validadoPor                 Usuario?             @relation("ValidadoPor", fields: [validadoPorId], references: [id_usuario])
  fechaValidacionDepartamento DateTime?
  etapaRechazo                String? // "DEPARTAMENTO" | "FACULTAD"
  // Declaración Jurada F02-CAD
  declaracionJuradaOpcion     String?
  fechaFirmaJurada            DateTime?

  @@unique([id_docente, id_periodo])
}

model CargaLectiva {
  id_carga_lectiva Int                @id @default(autoincrement())
  id_declaracion   Int
  id_curso         Int
  id_grupo         Int?
  tipo_clase       String // teoria, practica, laboratorio
  horas_semanales  Int
  grupos_asignados Int?
  sedeId           String?
  sede             Facultad?          @relation("CargaLectivaSede", fields: [sedeId], references: [id], onDelete: SetNull)
  curso            Curso              @relation(fields: [id_curso], references: [id_curso])
  grupo            Grupo?             @relation(fields: [id_grupo], references: [id_grupo])
  declaracion      DeclaracionHoraria @relation(fields: [id_declaracion], references: [id_declaracion])
}

model CargoAcademicoAdministrativo {
  id            String           @id @default(cuid())
  nombre        String           @unique
  chlm          Int              // carga lectiva mínima (reducida) que corresponde a este cargo
  chnlpe        Int              // no lectiva de preparación/evaluación
  chnla         Int              // no lectiva administrativa — esta es la que se autocompleta abajo
  cargasNoLectivas CargaNoLectiva[]
}

model CargaNoLectiva {
  id_carga_no_lectiva Int                    @id @default(autoincrement())
  id_declaracion      Int
  tipo                TipoCargaNoLectiva
  descripcion         String?
  horas_semanales     Int
  sedeId              String?
  sede                Facultad?              @relation("CargaNoLectivaSede", fields: [sedeId], references: [id], onDelete: SetNull)
  declaracion         DeclaracionHoraria     @relation(fields: [id_declaracion], references: [id_declaracion])
  ambiente            String?
  horarios            HorarioActividad[]
  cargoId             String?
  cargo               CargoAcademicoAdministrativo? @relation(fields: [cargoId], references: [id], onDelete: SetNull)
}

model HorarioActividad {
  id                      String                  @id @default(cuid())
  cargaNoLectivaId         Int?
  cargaNoLectiva         CargaNoLectiva?          @relation(fields: [cargaNoLectivaId], references: [id_carga_no_lectiva], onDelete: Cascade)
  cargaLectivaAdicionalId  String?
  cargaLectivaAdicional  CargaLectivaAdicional? @relation(fields: [cargaLectivaAdicionalId], references: [id], onDelete: Cascade)
  dia                     DiaSemana
  horaInicio              String                  // "HH:mm"
  horaFin                 String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                  @updatedAt
}

model CargaLectivaAdicional {
  id                  String                  @id @default(cuid())
  docenteId           Int
  docente             Docente                 @relation(fields: [docenteId], references: [id_docente])
  dependencia         DependenciaClad
  sedeId              String
  sede                Facultad                @relation("CargaLectivaAdicionalSede", fields: [sedeId], references: [id])
  curso               String
  numeroResolucion    String?
  fechaInicio         DateTime
  fechaFin            DateTime
  totalHoras          Int
  estado              EstadoClad              @default(BORRADOR)
  observaciones       String?
  validadoPorId       Int?
  validador           Usuario?                @relation("CladValidadoPor", fields: [validadoPorId], references: [id_usuario])
  fechaValidacion     DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  horarios            HorarioActividad[]
}

model IntegracionSimulada {
  id        String   @id @default(cuid())
  tipo      String   // "PERSONAL_ACADEMICO" | "INVESTIGACION_ETICA" | "RENACYT" | "SANCIONES"
  docenteId Int?
  docente   Docente? @relation(fields: [docenteId], references: [id_docente])
  payload   String   // JSON de entrada
  resultado String   // JSON de salida
  fecha     DateTime @default(now())
}

model FormatoDeclaracion {
  id_formato       Int                @id @default(autoincrement())
  id_declaracion   Int
  nombre_formato   String
  tipo_archivo     String // pdf, excel
  url_archivo      String?
  fecha_generacion DateTime           @default(now())
  declaracion      DeclaracionHoraria @relation(fields: [id_declaracion], references: [id_declaracion])
}