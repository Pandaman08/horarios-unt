# ═══════════════════════════════════════════════════════════════════════════════
# Horarios UNT — Environment Variables
# Copia este archivo como .env y completa los valores
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base de datos (Supabase) ──────────────────────────────────────────────────
# Transaction pooler (para la app normal — compatible con PgBouncer)
DATABASE_URL="postgresql://postgres.PROJECT_ID:PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres"

# Direct connection (para prisma db push / prisma migrate / seed — evita error de prepared statements)
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secret-minimo-32-caracteres-con-openssl-rand-base64-32"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="genera-otra-clave-secreta-diferente-al-nextauth"

# ── App URL (para Socket.IO y links internos) ────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Groq (IA / Chatbot) ──────────────────────────────────────────────────────
GROQ_API_KEY="tu-groq-api-key-aqui"

# ── Email SMTP (opcional) ────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="horarios@unt.edu.pe"

# ── Telegram Bot (opcional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""

# ── Cron secret (protege los endpoints /api/cron/* en Vercel) ─────────────────
CRON_SECRET="genera-un-secret-para-cron-jobs"
